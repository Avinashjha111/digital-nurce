# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Gemini
GEMINI_API_KEY=

# WhatsApp (Meta Cloud API). Per-clinic Phone Number ID + access token are
# entered through the Connect WhatsApp UI and stored in the database
# (whatsapp_credentials table, service-role access only) -- not here.
# WHATSAPP_WEBHOOK_SECRET is the shared "Verify Token" you set when
# registering the webhook URL in the Meta App dashboard.
WHATSAPP_WEBHOOK_SECRET=
# WHATSAPP_APP_SECRET is the Meta App's secret, used only to verify the
# X-Hub-Signature-256 header on incoming webhook POSTs. Optional in dev --
# if unset, signature verification is skipped (see route.ts).
WHATSAPP_APP_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reminder scheduler (Milestone 8). Vercel Cron sends this as a bearer
# token automatically when CRON_SECRET is set on the project -- generate
# any random string for it. Also used to call /api/cron/reminders manually
# in dev.
CRON_SECRET=

# Web Push (new-WhatsApp-message notifications). Generate a keypair once
# with `npx web-push generate-vapid-keys` and never regenerate it -- every
# existing browser subscription is tied to this specific keypair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
