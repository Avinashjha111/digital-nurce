# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Gemini
GEMINI_API_KEY=

# WhatsApp -- Twilio (ISV / Embedded Signup), one Twilio subaccount per
# clinic. TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN are the PARENT account,
# used only to create those subaccounts -- never to send messages (each
# clinic's own subaccount SID/token, stored in whatsapp_credentials, does
# that). The three NEXT_PUBLIC_* ids are all used client-side in the
# Facebook Login for Business popup (FB.login()), so they're inherently
# public regardless of the prefix.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=
NEXT_PUBLIC_TWILIO_SOLUTION_ID=

# App -- must be the real public URL in production (no trailing slash):
# Twilio webhook signature verification is computed over this exact URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reminder scheduler (Milestone 8). Vercel Cron sends this as a bearer
# token automatically when CRON_SECRET is set on the project -- generate
# any random string for it. Also used to call /api/cron/reminders manually
# in dev.
CRON_SECRET=

# Web Push (new-WhatsApp-message notifications). Generate a keypair once
# with `npx web-push generate-vapid-keys` and never regenerate it -- every
# existing browser subscription is tied to this specific keypair.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Razorpay Payment Links (agency billing).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Brevo (transactional email -- admin new-clinic notifications). Supabase's
# own auth emails (signup/login OTP) are configured separately via custom
# SMTP in the Supabase dashboard, not through this key.
BREVO_API_KEY=

# The one permanent agency_admin account (agency@digitalnurse.in) that owns
# every clinic created through the public /signup flow -- run
# `node scripts/create-master-agency.mjs` once and paste its user id here.
MASTER_AGENCY_ID=
